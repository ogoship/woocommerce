#: src/Product/Fields.php:69
msgid "These fields are read by OGOship when it syncs your catalogue. They are never shown to customers."
msgstr "OGOship lukee nämä kentät tuotetietoja synkronoidessaan. Niitä ei näytetä asiakkaille."

#: src/Product/Fields.php:113
msgid "Variations inherit these values. Open the Variations tab to give an individual variation its own EAN code or supplier details."
msgstr "Variaatiot perivät nämä arvot. Avaa Variaatiot-välilehti, jos haluat antaa yksittäiselle variaatiolle oman EAN-koodin tai toimittajatiedot."

#: src/Product/Repository.php:53
msgid "EAN code"
msgstr "EAN-koodi"

#: src/Product/Repository.php:54
msgid "Barcode used by the warehouse to identify this item when picking."
msgstr "Viivakoodi, jolla varasto tunnistaa tuotteen keräilyssä."

#: src/Product/Repository.php:59
msgid "Supplier name"
msgstr "Toimittajan nimi"

#: src/Product/Repository.php:60
msgid "Who you buy this product from. Shown on purchase orders."
msgstr "Keneltä ostat tämän tuotteen. Näkyy ostotilauksilla."

#: src/Product/Repository.php:65
msgid "Supplier code"
msgstr "Toimittajan koodi"

#: src/Product/Repository.php:66
msgid "The supplier's own article number for this product."
msgstr "Toimittajan oma tuotenumero tälle tuotteelle."

#: src/Product/Repository.php:71
msgid "Purchase price"
msgstr "Ostohinta"

#: src/Product/Repository.php:72
msgid "What the product costs you. Used for stock valuation, never shown to customers."
msgstr "Tuotteen hankintahinta. Käytetään varaston arvon laskentaan, ei näytetä asiakkaille."

#: src/Product/Repository.php:77
msgid "Product group"
msgstr "Tuoteryhmä"

#: src/Product/Repository.php:78
msgid "Free-text grouping used for warehouse reporting."
msgstr "Vapaamuotoinen ryhmittely varastoraportointia varten."

#: src/Product/Repository.php:83
msgid "Customs description"
msgstr "Tullikuvaus"

#: src/Product/Repository.php:84
msgid "Plain description of the goods for customs declarations on non-EU shipments."
msgstr "Selkokielinen tavarankuvaus EU:n ulkopuolisten lähetysten tulli-ilmoituksiin."

#: src/Product/Repository.php:89
msgid "Country of origin"
msgstr "Alkuperämaa"

#: src/Product/Repository.php:90
msgid "Two-letter country code where the product was manufactured, for example FI or CN."
msgstr "Kaksikirjaiminen maakoodi, jossa tuote on valmistettu, esimerkiksi FI tai CN."

#: src/Product/Repository.php:95
msgid "HS code"
msgstr "HS-koodi"

#: src/Product/Repository.php:96
msgid "Harmonised System tariff code used in customs declarations."
msgstr "Harmonoidun järjestelmän tullinimike, jota käytetään tulli-ilmoituksissa."

#: src/Product/Repository.php:101
msgid "Do not send to OGOship"
msgstr "Älä lähetä OGOshipiin"

#: src/Product/Repository.php:102
msgid "Exclude this product from OGOship. Use for digital goods and services that are never physically shipped."
msgstr "Jätä tämä tuote pois OGOshipista. Käytä digitaalisille tuotteille ja palveluille, joita ei koskaan toimiteta fyysisesti."

