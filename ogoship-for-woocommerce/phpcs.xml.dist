<?xml version="1.0"?>
<ruleset name="OGOship for WooCommerce">
	<description>WordPress and WooCommerce coding standards.</description>

	<file>.</file>
	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/node_modules/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="basepath" value="."/>
	<arg name="colors"/>
	<arg name="parallel" value="8"/>
	<arg value="ps"/>

	<!--
		WooCommerce-Core pulls in WordPress-Core/Docs/Extra plus WooCommerce's
		own sniffs. The escaping and nonce rules it enforces are the whole
		reason this file exists: the plugin this replaces shipped unescaped
		remote data straight into href attributes.
	-->
	<rule ref="WooCommerce-Core"/>

	<config name="minimum_supported_wp_version" value="6.5"/>
	<config name="testVersion" value="8.1-"/>
	<rule ref="PHPCompatibilityWP"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="ogoship-for-woocommerce"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="ogoship"/>
				<element value="OGOship\WooCommerce"/>
			</property>
		</properties>
	</rule>

	<!-- Capabilities registered by WooCommerce, which WPCS does not know about. -->
	<rule ref="WordPress.WP.Capabilities">
		<properties>
			<property name="custom_capabilities" type="array">
				<element value="edit_product"/>
				<element value="manage_woocommerce"/>
				<element value="view_woocommerce_reports"/>
			</property>
		</properties>
	</rule>

	<!--
		PSR-4 autoloading requires StudlyCaps class filenames, which is the
		opposite of WordPress's class-foo.php convention. PSR-4 wins here.
	-->
	<rule ref="WordPress.Files.FileName">
		<exclude-pattern>/src/*</exclude-pattern>
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>

	<!--
		Tests follow PHPUnit conventions, not WordPress ones: test methods are
		self-describing and do not carry doc blocks, data providers use
		unaligned arrays, and the suite deliberately calls the raw PHP
		functions it stubs. Correctness rules (escaping, nonces, sanitization)
		still apply; only the documentation and formatting sniffs are off.
	-->
	<rule ref="Squiz.Commenting">
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>
	<rule ref="Generic.Commenting">
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.Arrays.MultipleStatementAlignment">
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.PHP.DevelopmentFunctions">
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.WP.AlternativeFunctions">
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>
	<!--
		The bootstrap deliberately declares ABSPATH and bare WC_Product /
		WC_Order stubs so Mockery can mock them by name without loading
		WordPress. Prefixing those would defeat the point.
	-->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>
</ruleset>
