{
	"name": "ogoship/ogoship-for-woocommerce",
	"description": "Companion plugin for the OGOship fulfillment integration: OGOship product fields and customer-facing shipment tracking.",
	"type": "wordpress-plugin",
	"license": "MIT",
	"require": {
		"php": ">=8.1"
	},
	"require-dev": {
		"brain/monkey": "^2.6",
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0",
		"php-stubs/woocommerce-stubs": "^9.0",
		"phpcompatibility/phpcompatibility-wp": "^2.1",
		"phpstan/phpstan": "^2.0",
		"phpunit/phpunit": "^9.6",
		"szepeviktor/phpstan-wordpress": "^2.0",
		"woocommerce/woocommerce-sniffs": "^1.0",
		"wp-coding-standards/wpcs": "^3.1"
	},
	"autoload": {
		"psr-4": {
			"OGOship\\WooCommerce\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"OGOship\\WooCommerce\\Tests\\": "tests/unit/"
		}
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		},
		"optimize-autoloader": true,
		"sort-packages": true
	},
	"scripts": {
		"lint": "phpcs",
		"lint:fix": "phpcbf",
		"analyse": "phpstan analyse",
		"test": "phpunit --testsuite unit",
		"check": [
			"@lint",
			"@analyse",
			"@test"
		]
	}
}
