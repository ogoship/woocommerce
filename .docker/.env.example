# Copy to .env and adjust if the defaults collide with something already running.
# bin/setup.sh does this for you on first run.

# WP_PORT is the HTTPS port the Caddy proxy publishes -- the store is only
# reachable over TLS, because WooCommerce will not authenticate REST consumer
# keys otherwise. bin/setup.sh checks these are free before starting.
WP_PORT=8443
MAILPIT_PORT=8026

DB_NAME=wordpress
DB_USER=wordpress
DB_PASSWORD=wordpress
DB_ROOT_PASSWORD=root

# Credentials bin/setup.sh provisions. Local-only -- never reuse these anywhere.
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=admin
WP_ADMIN_EMAIL=dev@example.test

# Store defaults, matching the OGOship test store.
# Quoted because bin/setup.sh sources this file with the shell.
WP_TITLE="OGOship Plugin Dev Store"
WC_CURRENCY=EUR
WC_COUNTRY=FI
